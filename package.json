{
  "name": "dhamesh-prasad-portfolio",
  "version": "1.0.0",
  "description": "Professional portfolio website showcasing software engineering skills, projects, and experience",
  "keywords": [
    "portfolio",
    "software-engineer",
    "full-stack-developer",
    "react",
    "typescript",
    "tailwind-css",
    "web-development"
  ],
  "author": "Dhamesh Prasad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dharmeshim/dharmeshim.github.io.git"
  },
  "homepage": "https://dharmeshim.github.io",
  "source": "./index.html",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@studio-freight/lenis": "^1.0.42",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "2.1.1",
    "framer-motion": "^12.23.24",
    "gsap": "^3.12.5",
    "locomotive-scroll": "^5.0.1",
    "lucide-react": "^0.453.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^10.0.0",
    "react-router-dom": "^6.8.1",
    "react-type-animation": "^3.2.0",
    "react-use": "^17.5.1",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "^0.27.4",
    "gh-pages": "^6.3.0",
    "globals": "15.12.0",
    "tailwindcss": "3.4.16",
    "typescript": "^5.0.0",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "alias": {
    "@/*": "./src/components/ui/$1"
  }
}
